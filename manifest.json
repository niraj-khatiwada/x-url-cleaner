{
  "manifest_version": 3,
  "name": "X URL Cleaner",
  "version": "1.0.0",
  "description": "Remove query parameters from X post links as they are copied.",
  "minimum_chrome_version": "111",
  "action": {
    "default_title": "Clean a post link",
    "default_popup": "popup/popup.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*",
        "https://www.x.com/*",
        "https://twitter.com/*",
        "https://www.twitter.com/*",
        "https://mobile.twitter.com/*"
      ],
      "js": ["cleaner.js", "content.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
